rules_version = '2';

// Every document lives under users/{uid}/... — a signed-in user may only
// read/write their own subtree. No document outside users/{uid} is ever
// touched by the app, so nothing else needs a rule.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
